<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'PlayME MediaServer' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <% if (typeof user !== 'undefined' && user) { %>
    <nav class="navbar">
        <div class="nav-brand">🎵 PlayME Admin</div>
        <div class="nav-links">
            <a href="/admin">Dashboard</a>
            <a href="/admin/songs">Canciones</a>
            <a href="/admin/songs/new">Nueva canción</a>
            <a href="/logout">Cerrar sesión (<%= user %>)</a>
        </div>
    </nav>
    <% } %>

    <main class="container">
        <%- body %>
    </main>
</body>
</html>
